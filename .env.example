# Required
DEEPSEEK_API_KEY=sk-your-key-here

# Optional — defaults shown
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MAX_TOOL_ROUNDS=5
MAX_INPUT_LENGTH=4096
MAX_CONVERSATIONS=100
MAX_MESSAGES_PER_CONV=500

# Auth — leave empty for single-user dev mode (no auth required).
# Set to a random string to require Bearer token on all API calls.
AUTH_TOKEN=

# CORS — comma-separated origins, or * for all (dev only)
CORS_ORIGINS=*

# System prompt for the AI assistant
SYSTEM_PROMPT=You are a helpful AI assistant running on a Linux server. You can run shell commands, read and write files, and search the web. Be concise and helpful. When using tools, explain what you are doing.
